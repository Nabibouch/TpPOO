@model tp_a_rendre.Domain.Car
@{
    ViewData["Title"] = $"Détails - {Model.Model.Brand.Name} {Model.Model.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-flex align-items-center gap-1">
            <span>&larr; Retour à la liste</span>
        </a>
        <h1 class="display-5 fw-bold text-dark mb-0">@Model.Model.Brand.Name @Model.Model.Name</h1>
        <p class="text-secondary mb-0">@Model.Name - Immatriculation : <strong class="font-monospace">@Model.LicensePlate</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 shadow-sm">Modifier la voiture</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">Supprimer</a>
    </div>
</div>

<div class="row g-4">
    <!-- Fiche Technique -->
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-4 text-dark border-bottom pb-2">Spécifications techniques</h4>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Marque</span>
                            <strong class="text-dark fs-5">@Model.Model.Brand.Name</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Modèle</span>
                            <strong class="text-dark fs-5">@Model.Model.Name</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Immatriculation</span>
                            <strong class="text-dark fs-6 font-monospace">@Model.LicensePlate</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Carburant</span>
                            <strong class="text-dark fs-5">@Model.FuelType</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Année de mise en service</span>
                            <strong class="text-dark fs-5">@Model.Year</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <span class="d-block text-secondary small">Nombre de places</span>
                            <strong class="text-dark fs-5">@Model.SeatingCapacity places</strong>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-primary bg-opacity-10 rounded d-flex justify-content-between align-items-center">
                            <div>
                                <span class="d-block text-secondary small">Tarif Journalier</span>
                                <strong class="text-primary fs-3">@Model.Price.ToString("C0")</strong>
                            </div>
                            <span class="badge bg-primary px-3 py-2 rounded">Disponible</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Historique des réservations -->
    <div class="col-md-6 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h4 class="mb-0 fw-bold text-dark">Historique des réservations</h4>
            </div>
            <div class="card-body p-0">
                @if (!Model.Reservations.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <p class="mb-0">Aucune réservation enregistrée pour cette voiture.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary" style="font-size: 0.85rem;">
                                <tr>
                                    <th class="ps-4">Client</th>
                                    <th>Début</th>
                                    <th>Fin</th>
                                    <th class="pe-4 text-end">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Reservations.OrderByDescending(r => r.StartOn))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="d-block fw-bold text-dark">@reservation.Client.FirstName @reservation.Client.LastName</span>
                                            <small class="text-muted">@reservation.Client.Email</small>
                                        </td>
                                        <td>@reservation.StartOn.ToString("dd/MM/yyyy")</td>
                                        <td>@reservation.EndOn.ToString("dd/MM/yyyy")</td>
                                        <td class="pe-4 text-end">
                                            @{
                                                var isCurrent = DateTime.Today >= reservation.StartOn && DateTime.Today <= reservation.EndOn;
                                                var isPast = DateTime.Today > reservation.EndOn;
                                                var badgeClass = isCurrent ? "bg-success" : (isPast ? "bg-secondary" : "bg-info text-dark");
                                                var statusText = isCurrent ? "En cours" : (isPast ? "Terminée" : "À venir");
                                            }
                                            <span class="badge @badgeClass px-2 py-1">@statusText</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
