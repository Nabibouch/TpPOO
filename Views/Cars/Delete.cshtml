@model tp_a_rendre.Domain.Car
@{
    ViewData["Title"] = "Supprimer la voiture";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4 text-center">
                <div class="text-danger mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
                        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                    </svg>
                </div>
                
                <h3 class="fw-bold text-dark mb-3">Supprimer la voiture ?</h3>
                <p class="text-secondary mb-4">
                    Êtes-vous sûr de vouloir supprimer la voiture <strong>@Model.Model.Brand.Name @Model.Model.Name</strong> (@Model.Name) 
                    portant la plaque <strong>@Model.LicensePlate</strong> ? 
                    <br />
                    <span class="text-danger small fw-semibold">Cette action supprimera également toutes ses réservations associées.</span>
                </p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg shadow-sm">Confirmer la suppression</button>
                        <a asp-action="Index" class="btn btn-link text-muted">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
