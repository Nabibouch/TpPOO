@model tp_a_rendre.ViewModels.CarFormViewModel
@{
    ViewData["Title"] = "Nouvelle voiture";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h4 fw-bold text-dark mb-4 text-center">Nouvelle Voiture</h2>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrEmpty(Model.BusinessError))
                    {
                        <div class="alert alert-warning border-0 shadow-sm mb-4">
                            @Model.BusinessError
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ModelId" class="form-label fw-semibold text-secondary"></label>
                            <select asp-for="ModelId" asp-items="Model.Models" class="form-select border-2 shadow-none">
                                <option value="">-- Choisir un modèle --</option>
                            </select>
                            <span asp-validation-for="ModelId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Name" class="form-control border-2 shadow-none" placeholder="Ex: Phase II, dCi 90, etc." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LicensePlate" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="LicensePlate" class="form-control border-2 shadow-none font-monospace" placeholder="AB-123-CD" />
                            <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FuelType" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="FuelType" class="form-control border-2 shadow-none" placeholder="Essence, Diesel, Électrique, Hybride" />
                            <span asp-validation-for="FuelType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Year" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Year" type="number" class="form-control border-2 shadow-none" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="SeatingCapacity" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="SeatingCapacity" type="number" class="form-control border-2 shadow-none" />
                            <span asp-validation-for="SeatingCapacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="Price" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control border-2 shadow-none" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">Enregistrer la voiture</button>
                        <a asp-action="Index" class="btn btn-link text-muted">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
