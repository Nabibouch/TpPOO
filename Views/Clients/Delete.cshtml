@model tp_a_rendre.Domain.Client
@{
    ViewData["Title"] = "Supprimer le client";
}

<h1>Supprimer le client</h1>

<p>Confirmer la suppression de <strong>@Model.Prenom @Model.Nom</strong> ?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-link">Annuler</a>
</form>
