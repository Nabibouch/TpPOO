@model IEnumerable<tp_a_rendre.Domain.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Clients</h1>
    <a asp-action="Create" class="btn btn-primary">Nouveau client</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucun client enregistré pour le moment.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.LastName</td>
                    <td>@client.FirstName</td>
                    <td>@client.Email</td>
                    <td>@client.PhoneNumber</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
