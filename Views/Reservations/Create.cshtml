@model tp_a_rendre.ViewModels.ReservationFormViewModel
@{
    ViewData["Title"] = "Nouvelle réservation";
}

<h1>Nouvelle réservation</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (!string.IsNullOrEmpty(Model.BusinessError))
    {
        <div class="alert alert-warning">@Model.BusinessError</div>
    }

    <div class="mb-3">
        <label asp-for="ClientId" class="form-label"></label>
        <select asp-for="ClientId" asp-items="Model.Clients" class="form-select">
            <option value="">-- Choisir un client --</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CarId" class="form-label"></label>
        <select asp-for="CarId" asp-items="Model.Cars" class="form-select">
            <option value="">-- Choisir une voiture --</option>
        </select>
        <span asp-validation-for="CarId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartOn" class="form-label"></label>
        <input asp-for="StartOn" class="form-control" />
        <span asp-validation-for="StartOn" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndOn" class="form-label"></label>
        <input asp-for="EndOn" class="form-control" />
        <span asp-validation-for="EndOn" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Créer la réservation</button>
    <a asp-action="Index" class="btn btn-link">Annuler</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
