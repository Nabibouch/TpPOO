@model IEnumerable<tp_a_rendre.Domain.Reservation>
@{
    ViewData["Title"] = "Réservations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Réservations</h1>
    <a asp-action="Create" class="btn btn-primary">Nouvelle réservation</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucune réservation pour le moment.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Client</th>
                <th>Voiture</th>
                <th>Début</th>
                <th>Fin</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resa in Model)
            {
                <tr>
                    <td>@resa.Client.FirstName @resa.Client.LastName</td>
                    <td>@resa.Car.Model.Brand.Name @resa.Car.Model.Name (@resa.Car.LicensePlate)</td>
                    <td>@resa.StartOn.ToString("dd/MM/yyyy")</td>
                    <td>@resa.EndOn.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Delete" asp-route-id="@resa.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
