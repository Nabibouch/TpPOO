@model tp_a_rendre.ViewModels.ModelFormViewModel
@{
    ViewData["Title"] = "Nouveau modèle";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h4 fw-bold text-dark mb-4 text-center">Nouveau Modèle</h2>

                <form asp-action="CreateModel" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrEmpty(Model.BusinessError))
                    {
                        <div class="alert alert-warning border-0 shadow-sm mb-4">
                            @Model.BusinessError
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label fw-semibold text-secondary"></label>
                        <select asp-for="BrandId" asp-items="Model.Brands" class="form-select form-select-lg border-2 shadow-none">
                            <option value="">-- Choisir une marque --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary"></label>
                        <input asp-for="Name" class="form-control form-control-lg border-2 shadow-none" placeholder="Ex: Model 3, Prius, M3..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">Enregistrer le modèle</button>
                        <a asp-action="Index" class="btn btn-link text-muted">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
